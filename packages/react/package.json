{
  "name": "@lazorkit/react",
  "version": "2.1.0",
  "description": "Lazorkit Wallet SDK for Solana — passkey-native wallets with seedless onboarding and gasless transactions.",
  "license": "MIT",
  "homepage": "https://github.com/lazor-kit/lazor-kit/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/lazor-kit/lazor-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazor-kit/lazor-kit.git",
    "directory": "packages/react"
  },
  "keywords": [
    "solana",
    "wallet",
    "passkey",
    "webauthn",
    "secp256r1",
    "lazorkit",
    "sdk",
    "react",
    "wallet-standard"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "eventemitter3": "^5.0.1",
    "js-sha256": "^0.11.0"
  },
  "peerDependencies": {
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.0.0",
    "@solana/kora": "^0.1.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-standard-features": "^1.3.0",
    "@solana/web3.js": "^1.98.2",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "@wallet-standard/wallet": "^1.1.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-standard-features": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "@wallet-standard/wallet": "^1.1.0",
    "typescript": "^5.8.3"
  }
}
