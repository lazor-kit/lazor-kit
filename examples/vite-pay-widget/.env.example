# Lazorkit Configuration
# Copy this file to .env and fill in your values

# Solana RPC URL (Devnet for testing, Mainnet for production)
VITE_RPC_URL=https://api.devnet.solana.com

# Lazorkit Portal URL
VITE_PORTAL_URL=https://portal.lazorkit.com

# Lazorkit Paymaster URL (for gasless transactions)
VITE_PAYMASTER_URL=https://paymaster.lazorkit.com

# Network cluster (devnet or mainnet-beta)
VITE_CLUSTER=devnet
