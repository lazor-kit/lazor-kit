# Copy to .env and fill in. Never commit the real values.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_PORTAL_URL=https://portal.lazor.sh
EXPO_PUBLIC_PAYMASTER_URL=https://kora.devnet.lazorkit.com
# A paymaster key spends the sponsor's SOL. Use a devnet key here, and treat
# any key that ships inside an app bundle as public.
EXPO_PUBLIC_PAYMASTER_API_KEY=
